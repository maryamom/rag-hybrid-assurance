# Copy this file to .env and fill in the values. Never commit .env.

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=data
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# LLM (optional). Leave empty to start the API without the LLM.
# Get a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Quotation API
QUOTATION_API_URL=https://apidevis.onrender.com

# PDF extraction scripts (data_extraction/)
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/pdf_processor
