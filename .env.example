# Copy this file to .env and fill it in. Never commit .env.

# --- PostgreSQL (client records, OCR text) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=data
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# --- Neo4j (public knowledge graph) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Qdrant (public vector index) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=insurance_knowledge
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- LLM (optional) ---
# Leave empty to run without the LLM: answers then list the most relevant passages.
# Get a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
LLM_MODEL=deepseek/deepseek-chat-v3.1
LLM_TEMPERATURE=0.1
# Vision model used by data_extraction/ to OCR the scanned PDFs
OCR_MODEL=openai/gpt-4o-mini

# --- Client authentication (codes sent by e-mail) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# true = print verification codes in the server console instead of e-mailing them.
# Only for local demos with the hackathon's fictitious clients.
AUTH_DEMO_MODE=false
SESSION_TTL_SECONDS=7200

# --- Quote API ---
QUOTATION_API_URL=https://apidevis.onrender.com/api/auto/packs
